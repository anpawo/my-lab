#!/bin/sh
# Waits for the network, then runs the command. A cron that fires without wifi doesn't fail
# its job: it turns red in Fleet and has to wait for the next slot, when all it needed was to
# wait for the connection. Deferral, not failure — hence the exit 0 when giving up.
#
# ONLINE_WAIT: seconds to wait before giving up (default 20 min). Keep it under the job's
# interval, otherwise two runs step on each other.
[ $# -gt 0 ] || { echo "usage: online <command> [args...]" >&2; exit 64; }
WAIT=${ONLINE_WAIT:-1200}
deadline=$(( $(date +%s) + WAIT ))
# The same check macOS itself runs. A captive portal answers 200 with its own page, so the
# word in the body is what decides, not the HTTP code.
until curl -sf -m 5 http://captive.apple.com/hotspot-detect.html 2>/dev/null | grep -q Success; do
  if [ "$(date +%s)" -ge "$deadline" ]; then
    echo "$(date '+%F %T') online: no network after $((WAIT / 60)) min, deferred to the next slot" >&2
    exit 0
  fi
  sleep 90
done
exec "$@"
