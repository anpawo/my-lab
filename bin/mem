#!/usr/bin/env python3
"""
memhog.py — show the top 5 memory-hungry processes and optionally kill them.
"""

import subprocess
import sys
import os

RED    = "\033[91m"
YELLOW = "\033[93m"
CYAN   = "\033[96m"
BOLD   = "\033[1m"
DIM    = "\033[2m"
RESET  = "\033[0m"

TOP_N = 5


def get_processes():
    out = subprocess.check_output(
        ["ps", "-eo", "pid,rss,pmem,pcpu,comm"],
        text=True,
    )
    procs = []
    for line in out.splitlines()[1:]:          # skip header
        parts = line.split(None, 4)
        if len(parts) < 5:
            continue
        pid, rss, pmem, pcpu, comm = parts
        try:
            procs.append({
                "pid":   int(pid),
                "rss":   int(rss),            # KB
                "pmem":  float(pmem),         # %
                "pcpu":  float(pcpu),
                "comm":  comm.strip(),
            })
        except ValueError:
            pass
    procs.sort(key=lambda p: p["rss"], reverse=True)
    return procs[:TOP_N]


def fmt_mem(kb: int) -> str:
    if kb >= 1_048_576:
        return f"{kb / 1_048_576:.1f} GB"
    if kb >= 1_024:
        return f"{kb / 1_024:.0f} MB"
    return f"{kb} KB"


def mem_color(pmem: float) -> str:
    if pmem >= 10:
        return RED
    if pmem >= 3:
        return YELLOW
    return RESET


def print_table(procs):
    print(f"\n{BOLD}  #   PID      Memory       %MEM   %CPU   Process{RESET}")
    print(f"{DIM}  {'─'*60}{RESET}")
    for i, p in enumerate(procs, 1):
        col  = mem_color(p["pmem"])
        name = p["comm"].split("/")[-1][:40]
        print(
            f"  {CYAN}{i}{RESET}   "
            f"{p['pid']:<7}  "
            f"{col}{fmt_mem(p['rss']):>10}{RESET}   "
            f"{col}{p['pmem']:>4.1f}%{RESET}   "
            f"{p['pcpu']:>4.1f}%   "
            f"{name}"
        )
    print()


def prompt_selection(procs) -> list[dict]:
    print(
        f"Kill which? "
        f"{DIM}(e.g. 1 3, 'all', or Enter to cancel){RESET} → ",
        end="",
        flush=True,
    )
    try:
        raw = input().strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return []

    if not raw:
        return []

    if raw == "all":
        return procs[:]

    chosen = []
    for token in raw.split():
        try:
            idx = int(token)
            if 1 <= idx <= len(procs):
                chosen.append(procs[idx - 1])
            else:
                print(f"{YELLOW}  '{idx}' out of range — skipped{RESET}")
        except ValueError:
            print(f"{YELLOW}  '{token}' is not a number — skipped{RESET}")

    # deduplicate while preserving order
    seen = set()
    return [p for p in chosen if not (p["pid"] in seen or seen.add(p["pid"]))]


def kill_processes(targets: list[dict]):
    if not targets:
        print(f"{DIM}  Nothing to kill.{RESET}\n")
        return

    print()
    for p in targets:
        name = p["comm"].split("/")[-1]
        try:
            os.kill(p["pid"], 9)
            print(f"  {RED}✕{RESET} Killed {BOLD}{name}{RESET} (PID {p['pid']})")
        except ProcessLookupError:
            print(f"  {DIM}  {name} (PID {p['pid']}) already gone{RESET}")
        except PermissionError:
            print(
                f"  {YELLOW}  No permission to kill {name} (PID {p['pid']}) "
                f"— try sudo{RESET}"
            )
    print()


def main():
    try:
        procs = get_processes()
    except Exception as e:
        sys.exit(f"Error reading processes: {e}")

    if not procs:
        print("No processes found.")
        return

    print_table(procs)
    targets = prompt_selection(procs)
    kill_processes(targets)


if __name__ == "__main__":
    main()
