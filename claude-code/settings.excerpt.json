{
  "statusLine": {
    "command": "bash ~/.claude/statusline.sh",
    "refreshInterval": 5,
    "type": "command"
  },
  "hooks": {
    "MessageDisplay": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/adhd-colors.sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/session-start-memory.py",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "python3 ~/.claude/trust-folders.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/context-guard.py",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "theme": "custom:mr"
}
